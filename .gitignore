# Root .gitignore
.env
.env.*
!.env.example
!.env.ci
.env.backup
.env.production
*.pem
*.key
*.p12
*.pfx
node_modules
node_modules/
vendor
vendor/
/public/hot
/public/storage
.phpunit.result.cache
*.log

# Laravel
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.ci
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*
backend/public/storage
backend/public/hot

# Frontend
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/dist/
frontend/dist-ssr/
*.local

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
