{
  "name": "mageshop-nestjs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for the MageShop API.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false --pretty false",
    "start": "node dist/main.js",
    "seed": "node dist/seed.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@types/pdfkit": "^0.17.7",
    "bcryptjs": "^3.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
