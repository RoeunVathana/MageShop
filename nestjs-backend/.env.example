NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080

# Shared PostgreSQL database used by the NestJS API.
DATABASE_URL=
DB_SSL=true
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_POOL_MAX_USES=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# Optional Redis connection used for readiness checks, cache, and events.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000

# Optional durable media storage. If omitted, local storage is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_ROOT=./storage/app/public

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional n8n event webhook. Events are non-blocking and never roll back API transactions.
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=5000

# Telegram order/payment report image (used with sendPhoto, with sendMessage fallback).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_REPORT_IMAGE_URL=https://tyushop.blog/logo.png

BAKONG_API_ENABLED=true
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=TYUSHOP
BAKONG_MERCHANT_CITY=Phnom Penh

# Set only for a controlled administrator maintenance operation.
ALLOW_REMOTE_SEEDING=false

# TYUSHOP AI Support. Set one provider key on the deployed NestJS service.
# OPENAI_API_KEY= or GEMINI_API_KEY= may be used directly. AI_API_KEY is
# supported for compatibility with the Laravel configuration.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# NestJS seed runner compatibility with Laravel DatabaseSeeder.
# The seed endpoint never runs unless ALLOW_REMOTE_SEEDING=true and the caller is an admin.
FORCE_RESEED=false
SEED_DEMO_DATA=false
# Populate safe, repeatable records for catalog, seller, order, payment,
# delivery, inventory, support, wishlist, loyalty, and Telegram testing.
SEED_TEST_DATA=false
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
MASTER_ADMIN_NAME=Platform Administrator
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
