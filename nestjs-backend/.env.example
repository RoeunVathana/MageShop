NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080

# Shared PostgreSQL database used by the NestJS API.
DATABASE_URL=

# Optional durable media storage. If omitted, local storage is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_ROOT=./storage/app/public

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

BAKONG_API_ENABLED=true
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=TYUSHOP
BAKONG_MERCHANT_CITY=Phnom Penh

# Set only for a controlled administrator maintenance operation.
ALLOW_REMOTE_SEEDING=false
