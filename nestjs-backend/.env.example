NODE_ENV=development
PORT=8080

# Keep Laravel as the source of truth during migration.
LARAVEL_API_ORIGIN=https://api.tyushop.blog

# Shared PostgreSQL connection used only after the NestJS catalog module has
# passed parity checks. Leave empty to use the Laravel compatibility gateway.
DATABASE_URL=
NEST_DIRECT_CATALOG=false
NEST_DIRECT_CATALOG_ADMIN=false
NEST_DIRECT_AUTH=false
NEST_DIRECT_ORDERS=false
NEST_DIRECT_CHECKOUT=false
NEST_DIRECT_DELIVERY_READS=false
NEST_DIRECT_DELIVERY_MUTATIONS=false
NEST_DIRECT_OPERATIONS_READS=false
NEST_DIRECT_OPERATIONS_MUTATIONS=false
NEST_DIRECT_PAYMENT_CONFIRM=false
NEST_DIRECT_PAYMENT_ACCOUNTS=false
NEST_DIRECT_INVENTORY=false
NEST_DIRECT_ADMIN_ORDERS=false
NEST_DIRECT_ADMIN_SECURITY=false
NEST_DIRECT_BANNER_READS=false
NEST_DIRECT_BANNER_ADMIN=false
NEST_DIRECT_SELLERS=false
NEST_DIRECT_COUPONS=false
NEST_DIRECT_STORE_SETTINGS=false
NEST_DIRECT_MEDIA=false
NEST_DIRECT_DELIVERY_SETTINGS=false
NEST_DIRECT_ENGAGEMENT=false
NEST_DIRECT_API_TOKENS=false

# The gateway accepts the same API paths as Laravel, including /api/v1.
API_PREFIX=

# Set to false only for a local trusted development environment.
PROXY_TRUST_PROXY=true
