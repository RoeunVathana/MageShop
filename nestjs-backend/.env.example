NODE_ENV=development
PORT=8080

# Keep Laravel as the source of truth during migration.
LARAVEL_API_ORIGIN=https://api.tyushop.blog

# Shared PostgreSQL connection used only after the NestJS catalog module has
# passed parity checks. Leave empty to use the Laravel compatibility gateway.
DATABASE_URL=
NEST_DIRECT_CATALOG=false
NEST_DIRECT_AUTH=false

# The gateway accepts the same API paths as Laravel, including /api/v1.
API_PREFIX=

# Set to false only for a local trusted development environment.
PROXY_TRUST_PROXY=true
